+/// An inclusive numeric range a client may submit for one knob.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct VideoRange<T> {
+    pub min: T,
+    pub max: T,
+}
+
+/// What a `capabilities: [video]` recipe accepts, for clients that drive
+/// `/v1/videos`.
+///
+/// The capability flag says a model generates video; it says nothing about *how to
+/// ask*. That matters because the request surface is per-model, not per-engine:
+/// MiniMax-H3 takes its own canonical body (`task` / `target` / `conditions`) while
+/// the generic SGLang video API takes `seconds` / `size` / `input_reference`. A
+/// client that guesses wrong does not get an error — the engine drops the fields it
+/// does not know and generates something at its own defaults, so the caller pays
+/// full GPU time for a clip of the wrong length with its conditioning frames
+/// silently ignored.
+///
+/// Nothing here is inferred. An operator writing a recipe knows which body the
+/// model wants and what it will reject; this is where that knowledge stops being
+/// tribal. Omitted entirely means "undeclared", which a client should treat as
+/// "do not drive this automatically" rather than guessing.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct VideoProfile {
+    /// Identifier of the request body a client must build, e.g.
+    /// `minimax_h3.request/v1` or `sglang.video/v1`. The one field with no sensible
+    /// default: it is the difference between a correct clip and a silently wrong one.
+    pub request_schema: String,
+    /// The only short edge the model accepts, when it is fixed (H3: 768).
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub short_edge: Option<u32>,
+    /// Accepted aspect ratios. Empty means the model does not constrain them.
+    #[serde(default, skip_serializing_if = "Vec::is_empty")]
+    pub aspect_ratios: Vec<String>,
+    /// Output pixel size per aspect ratio, as the engine actually returns it —
+    /// arithmetic gets this wrong when the model snaps the long edge to a patch
+    /// size (768 at 16:9 is 1365 by calculation and 1344 in practice).
+    #[serde(default, skip_serializing_if = "HashMap::is_empty")]
+    pub sizes: HashMap<String, String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub duration_seconds: Option<VideoRange<f32>>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub num_inference_steps: Option<VideoRange<u32>>,
+    /// Measured wall clock for one denoise step, which is the only progress signal
+    /// a client has for a model that reports `queued` until it is done.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub seconds_per_step: Option<f32>,
+    /// Whether first/last-frame conditioning is supported at all.
+    #[serde(default)]
+    pub keyframes: bool,
+    /// Whether the output carries an audio track.
+    #[serde(default)]
+    pub audio: bool,
+}
