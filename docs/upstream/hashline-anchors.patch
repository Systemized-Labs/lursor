+class TestCrlf:
+    """A CRLF file must not end up with mixed line endings, or `\r` in its hashes."""
+
+    CRLF = "alpha\r\nbeta\r\ngamma\r\n"
+
+    def test_tags_do_not_include_the_carriage_return(self):
+        assert format_hashline_output(self.CRLF).splitlines() == [
+            f"1:{line_hash('alpha')}|alpha",
+            f"2:{line_hash('beta')}|beta",
+            f"3:{line_hash('gamma')}|gamma",
+        ]
+
+    def test_an_edit_keeps_the_files_own_ending(self):
+        new, error = apply_hashline_edit(self.CRLF, 2, line_hash("beta"), "BETA")
+        assert error is None
+        assert new == "alpha\r\nBETA\r\ngamma\r\n"
+
+    def test_lf_files_are_unaffected(self):
+        content = "alpha\nbeta\n"
+        new, error = apply_hashline_edit(content, 2, line_hash("beta"), "BETA")
+        assert error is None
+        assert new == "alpha\nBETA\n"
+
+    def test_multi_line_replacement_keeps_the_ending(self):
+        new, error = apply_hashline_edit(
+            self.CRLF, 1, line_hash("alpha"), "one\ntwo", end_line=2, end_hash=line_hash("beta")
+        )
+        assert error is None
+        assert new == "one\r\ntwo\r\ngamma\r\n"
+
