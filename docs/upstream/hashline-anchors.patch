     Returns:
-        2-character lowercase hex string.
+        Lowercase hex string of `HASH_WIDTH` characters.
+    """
+    return hashlib.md5(content.strip().encode("utf-8")).hexdigest()[:HASH_WIDTH]
+
+
+def hash_matches(expected: str, actual: str) -> bool:
+    """Whether a caller-supplied hash matches one computed now.
+
+    Compared on the shorter of the two lengths so a hash a model read before this
+    change (2 characters) still validates against a 4-character one. Without that,
+    every conversation in flight across an upgrade fails its next edit.
     """
-    return hashlib.md5(content.encode("utf-8")).hexdigest()[:2]
+    if not expected:
+        return False
+    width = min(len(expected), len(actual))
+    return expected[:width].lower() == actual[:width].lower()
 
 
