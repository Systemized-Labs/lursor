+class TestHashMatches:
+    """Anchors a model read before the width change still have to validate."""
+
+    def test_exact(self):
+        assert hash_matches(line_hash("hello"), line_hash("hello"))
+
+    def test_a_shorter_legacy_hash_still_matches(self):
+        """A 2-char anchor from an in-flight conversation must not break on upgrade."""
+        full = line_hash("hello")
+        assert hash_matches(full[:2], full)
+
+    def test_case_insensitive(self):
+        full = line_hash("hello")
+        assert hash_matches(full.upper(), full)
+
+    def test_different_content_does_not_match(self):
+        assert not hash_matches(line_hash("hello"), line_hash("goodbye"))
+
+    def test_empty_expected_never_matches(self):
+        assert not hash_matches("", line_hash("hello"))
+
