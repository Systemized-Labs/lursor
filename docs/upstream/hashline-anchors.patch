+def _line_ending(content: str) -> str:
+    """The newline this file uses, so an edit does not mix the two.
+
+    Splitting on `\n` alone leaves a trailing `\r` on every line of a CRLF file:
+    the model is then asked to hash an invisible character, and any line it writes
+    lands with a bare LF next to CRLF neighbours.
+    """
+    return "\r\n" if "\r\n" in content else "\n"
