# Cask template for the Lursor Homebrew tap (Systemized-Labs/homebrew-lursor).
#
# NOT IN USE YET: the tap repo does not exist and HOMEBREW_TAP_TOKEN is unset, so
# the release workflow's bump step skips. See docs/DISTRIBUTION.md before
# enabling — signing has to land first, per the quarantine note below.
#
# The release workflow substitutes @@VERSION@@ / @@SHA256@@ and pushes the result
# to Casks/lursor.rb in the tap repo. Don't edit the tap copy by hand — it is
# overwritten on every release.
#
# Notes:
#   - arm64 only, matching what the release workflow builds.
#   - auto_updates true tells Homebrew the app updates itself (electron-updater),
#     so `brew upgrade` won't fight the in-app updater.
#   - Homebrew dropped --no-quarantine in 4.7, so this only works because the
#     DMG is signed and notarized.
cask "lursor" do
  version "@@VERSION@@"
  sha256 "@@SHA256@@"

  url "https://github.com/Systemized-Labs/lursor/releases/download/v#{version}/Lursor-#{version}-mac-arm64.dmg"
  name "Lursor"
  desc "Self-hosted agent harness with workspaces, live terminal, and git review"
  homepage "https://github.com/Systemized-Labs/lursor"

  livecheck do
    url :url
    strategy :github_latest
  end

  auto_updates true
  depends_on arch: :arm64
  # ffmpeg is a real runtime dependency, not a nicety: the video tools materialize
  # clips that the ``video-production`` skill then cuts with ffmpeg, and
  # ``view_video`` cannot see a clip at all without ffmpeg/ffprobe. It is
  # deliberately not vendored — ~80 MB, plus a GPL-vs-LGPL and encoder-patent
  # question this project has no business answering to ship a convenience. Note
  # that Homebrew's formula is built without libfreetype, so ``drawtext`` is
  # absent; the skill carries an ``overlay`` fallback for burned-in text.
  depends_on formula: "ffmpeg"

  app "Lursor.app"

  # ~/.lursor holds workspaces, skills, media and the SQLite DB, so it is only
  # removed by an explicit `brew uninstall --zap`, never a plain uninstall.
  zap trash: [
    "~/.lursor",
    "~/Library/Application Support/Lursor",
    "~/Library/Logs/Lursor",
    "~/Library/Preferences/com.lursor.app.plist",
    "~/Library/Saved Application State/com.lursor.app.savedState",
  ]
end
