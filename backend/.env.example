# Copy to .env and fill in. All values are optional except a provider key.

# Provider API key. Models are served through OpenRouter.
OPENROUTER_API_KEY=

# Default model used when an agent does not specify one (OpenRouter model id)
DEFAULT_MODEL=openrouter:qwen/qwen3.7-max

# Server
DEBUG=true
# JSON array of allowed CORS origins
CORS_ORIGINS=["http://localhost:8888","http://127.0.0.1:8888"]

# Bearer token required on every route. Leave unset for a local backend on
# loopback, which is the default posture and needs no credential.
#
# Set it to run the backend on another machine and connect the desktop app to it
# (see docs/REMOTE.md). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# It is worth as much as an SSH key to this host — always pair it with TLS.
# LURSOR_AUTH_TOKEN=

# Storage (defaults are fine for local dev)
# DATABASE_URL=sqlite+aiosqlite:///./lursor.db
# WORKSPACES_DIR=./workspaces
