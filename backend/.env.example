# Copy to .env and fill in. All values are optional except a provider key.

# Provider API key. Models are served through OpenRouter.
OPENROUTER_API_KEY=

# Default model used when an agent does not specify one (OpenRouter model id)
DEFAULT_MODEL=openrouter:qwen/qwen3.7-max

# Server
DEBUG=true
# JSON array of allowed CORS origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Storage (defaults are fine for local dev)
# DATABASE_URL=sqlite+aiosqlite:///./hearthstack.db
# WORKSPACES_DIR=./workspaces
